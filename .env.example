ENV=dev

APP_DB_PASSWORD=app_dev_pw
APP_DB_URL=postgresql+asyncpg://app:app_dev_pw@app-db:5432/app

WAREHOUSE_HOST=warehouse
WAREHOUSE_PORT=5432
WAREHOUSE_DB=warehouse
WAREHOUSE_ADMIN_USER=wh_admin
WAREHOUSE_ADMIN_PASSWORD=wh_admin_dev_pw
WAREHOUSE_VIEWER_PASSWORD=wh_viewer_dev_pw
WAREHOUSE_ANALYST_PASSWORD=wh_analyst_dev_pw
WAREHOUSE_SEED_SCALE=1.0

# Required, >= 32 chars. `make env` fills it with `openssl rand -hex 32`.
JWT_SECRET=
JWT_TTL_MINUTES=480
DEMO_PASSWORD=demo1234

# Host ports (change if already in use)
API_PORT=8000
WEB_PORT=8080

REDIS_URL=redis://redis:6379/0
DATA_AS_OF=2026-08-31

# LLM providers — only providers with a key (or URL) join the failover chain.
# With none set, the copilot answers common questions via rule-based fallback.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# e.g. http://ollama:11434 with `docker compose --profile local-llm up`
OLLAMA_BASE_URL=
